# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development           # development | production
DEBUG=true
APP_VERSION=1.0.0

# ── Infrastructure passwords ───────────────────────────────────────────────────
# Optional in dev (docker-compose.yaml defaults both to "secret").
# REQUIRED for docker-compose.prod.yaml — startup fails fast without them,
# and config.py refuses to boot production with the dev password "secret".
# POSTGRES_PASSWORD=<strong password>
# REDIS_PASSWORD=<strong password>

# ── LLM (any OpenAI-compatible endpoint) ──────────────────────────────────────
# Groq (current default) — get a key at console.groq.com
LLM_API_KEY=gsk_...
MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_REASONING_EFFORT=low          # low | medium | high | "" (omit param)

# ── Apify (job recommendations — LinkedIn/Naukri/Indeed crawling) ──────────────
# Account-level token from console.apify.com — optional; those 3 sources are
# skipped gracefully if unset.
APIFY_API_TOKEN=apify_api_...

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Local dev  (docker-compose spins this up for you):
DATABASE_URL=postgresql+asyncpg://atsready:secret@127.0.0.1:5432/atsready

# Neon (production serverless Postgres — free tier available):
# DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.us-east-1.aws.neon.tech/atsready?sslmode=require

# Sync URL used only by Alembic CLI (not by the app at runtime):
SYNC_DATABASE_URL=postgresql+psycopg2://atsready:secret@127.0.0.1:5432/atsready

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local dev (docker-compose):
REDIS_URL=redis://:secret@127.0.0.1:6379/0

# Upstash (production serverless Redis — free tier available):
# REDIS_URL=rediss://default:token@hostname.upstash.io:6379

# ── File Storage — Cloudflare R2 (recommended: no egress fees) ───────────────
# Create a bucket in your Cloudflare dashboard, then generate R2 API tokens.
S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your-r2-access-key-id
S3_SECRET_ACCESS_KEY=your-r2-secret-access-key
S3_BUCKET_NAME=ats-ready-resumes
S3_REGION=auto                    # R2 uses "auto"; real S3: us-east-1 etc.

# Public base URL for downloads (set after you enable public access or add a domain):
CDN_BASE_URL=https://files.ats-ready.com

# ── Resume Generation ─────────────────────────────────────────────────────────
MAX_SKILLS_IN_RESUME=12
MAX_PROJECTS_IN_RESUME=4
MAX_EXPERIENCE_BULLETS=5
OUTPUT_DIR=outputs                # local temp dir; files are uploaded to S3 then deleted

# ── ATS Scoring Weights (must sum to 1.0) ────────────────────────────────────
ATS_KEYWORD_WEIGHT=0.40
ATS_SKILLS_WEIGHT=0.30
ATS_ACTION_VERB_WEIGHT=0.15
ATS_FORMAT_WEIGHT=0.15

# ── Scraper ───────────────────────────────────────────────────────────────────
SCRAPE_TIMEOUT=15
RESPECT_ROBOTS_TXT=true

# ── Background Jobs ───────────────────────────────────────────────────────────
# Max time (seconds) a job can run before being killed
JOB_TIMEOUT=120
# How many ARQ worker processes to spawn
WORKER_CONCURRENCY=5

# ── Sentry (optional — error tracking) ───────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Auth (needed in Step 2 — define now so config.py is ready) ───────────────
JWT_SECRET=change-me-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30
FRONTEND_URL=http://localhost:5173
