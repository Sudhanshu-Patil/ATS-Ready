# ─── Gemini ────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# Model options: gpt-4o | gpt-4o-mini | gpt-4-turbo
# gpt-4o-mini is ~10x cheaper and still very capable for resume tasks
MODEL=gpt-4o

# ─── Database ──────────────────────────────────────────────────────────────────
# Default: SQLite in project root. Change to postgres:// for production.
# DATABASE_URL=sqlite:///./metabase.db

# ─── Scraper ───────────────────────────────────────────────────────────────────
# Set to false to ignore robots.txt (use at your own risk)
RESPECT_ROBOTS_TXT=true
SCRAPE_TIMEOUT=15

# ─── Resume Settings ───────────────────────────────────────────────────────────
MAX_SKILLS_IN_RESUME=12
MAX_PROJECTS_IN_RESUME=4
MAX_EXPERIENCE_BULLETS=5
